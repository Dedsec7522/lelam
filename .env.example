# Copy to .env.local and fill in. Never commit real values.

# Public site origin used for canonical URLs, sitemap and emails.
NEXT_PUBLIC_SITE_URL=https://www.lelam.co

# REQUIRED in production: 32+ random characters for signing session cookies.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional: path of the JSON data store (default ./.data/db.json). Use a real database in production.
# LELAM_DB_PATH=

# Payments: demo (default outside production) | live (needs Razorpay keys; gateway wiring pending) | unset in production = disabled
# PAYMENTS_MODE=demo
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Transactional email via Resend (password resets, lead notifications). Without it, emails are logged in dev.
# RESEND_API_KEY=
# EMAIL_FROM="Lelam <no-reply@lelam.co>"

# Optional assistant LLM (any OpenAI-compatible chat completions endpoint). Server-side only.
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=

# Development-only rate-limit headroom (ignored in production).
# RATE_LIMIT_MULTIPLIER=25
